    <mxCell id="10"
      value="&lt;font style=&quot;font-size:18px;font-weight:bold;&quot;&gt;logdaemon — Flow State Architecture&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#64748b;&quot;&gt;init.rc Native Daemon  ·  Android Log Capture System&lt;/font&gt;"
      style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;"
      vertex="1" parent="1">
      <mxGeometry x="80" y="20" width="640" height="60" as="geometry"/>
    </mxCell>

    <!-- ═══════════════════════════════════════════════════
         STATE 1 — BOOT
    ═══════════════════════════════════════════════════ -->
    <mxCell id="20"
      value="&lt;font style=&quot;font-size:13px;font-weight:bold;color:#1d4ed8;&quot;&gt;1  |  Boot&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#374151;&quot;&gt;· init reads logdaemon.rc at device boot&lt;br&gt;· Daemon started as uid = 0 (root)&lt;br&gt;· Waits for sys.boot_completed = 1&lt;br&gt;· Auto-restarts every 5s on exit&lt;/font&gt;"
      style="rounded=1;html=1;fillColor=#eff6ff;strokeColor=#93c5fd;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=16;spacingTop=12;spacingBottom=12;"
