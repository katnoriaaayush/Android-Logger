      vertex="1" parent="1">
      <mxGeometry x="80" y="549" width="640" height="272" as="geometry"/>
    </mxCell>

    <!-- "running in parallel" label -->
    <mxCell id="53"
      value="—— running in parallel ——"
      style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=10;fontColor=#94a3b8;"
      vertex="1" parent="1">
      <mxGeometry x="80" y="588" width="640" height="20" as="geometry"/>
    </mxCell>

    <!-- Main Thread sub-card -->
    <mxCell id="51"
      value="&lt;font style=&quot;font-size:12px;font-weight:bold;color:#065f46;&quot;&gt;Main Thread&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#374151;&quot;&gt;· Reads logcat pipe as root&lt;br&gt;· Captures logs from all user profiles&lt;br&gt;· Matches PID → target package&lt;br&gt;· Writes .log / .tsv to internal storage&lt;br&gt;· Checkpoints .last_ts every 64 lines&lt;/font&gt;"
      style="rounded=1;html=1;fillColor=#ecfdf5;strokeColor=#6ee7b7;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingBottom=10;"
      vertex="1" parent="1">
      <mxGeometry x="94" y="614" width="293" height="196" as="geometry"/>
    </mxCell>

    <!-- Sync Thread sub-card -->
    <mxCell id="52"
      value="&lt;font style=&quot;font-size:12px;font-weight:bold;color:#854d0e;&quot;&gt;Sync Thread&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#374151;&quot;&gt;· Wakes every 5s (poll timeout)&lt;br&gt;· inotify watches USB root for IN_UNMOUNT&lt;br&gt;· Reads offset → streams 64 KB chunk&lt;br&gt;· open → fwrite → close per cycle&lt;br&gt;· 5s debounce: profile switch vs real eject&lt;/font&gt;"
      style="rounded=1;html=1;fillColor=#fefce8;strokeColor=#fde047;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;spacingBottom=10;"
      vertex="1" parent="1">
      <mxGeometry x="413" y="614" width="293" height="196" as="geometry"/>
    </mxCell>

    <!-- Arrow 4: Active → End -->
    <mxCell id="83"
      value="USB ejected  (IN_UNMOUNT + 5s debounce)"
      style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#94a3b8;strokeWidth=2;fontSize=10;fontColor=#475569;fillColor=#f1f5f9;labelBackgroundColor=#f1f5f9;labelBorderColor=#e2e8f0;rounded=1;"
      edge="1" source="50" target="60" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- ═══════════════════════════════════════════════════
         STATE 5 — SESSION END
    ═══════════════════════════════════════════════════ -->
    <mxCell id="60"
      value="&lt;font style=&quot;font-size:13px;font-weight:bold;color:#c2410c;&quot;&gt;5  |  Session End&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#374151;&quot;&gt;· g_usb_gone = 1  →  capture loop exits cleanly&lt;br&gt;· Log writers flushed and closed&lt;br&gt;· _summary.tsv written to internal storage&lt;br&gt;· Sync thread performs final USB flush&lt;br&gt;· Process exits  →  init restarts daemon after 5s&lt;/font&gt;"
      style="rounded=1;html=1;fillColor=#fff7ed;strokeColor=#fdba74;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=16;spacingTop=12;spacingBottom=12;"
      vertex="1" parent="1">
