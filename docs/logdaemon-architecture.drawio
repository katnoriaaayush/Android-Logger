      style="rounded=1;html=1;fillColor=#f5f3ff;strokeColor=#c4b5fd;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=16;spacingTop=12;spacingBottom=12;"
      vertex="1" parent="1">
      <mxGeometry x="80" y="248" width="640" height="95" as="geometry"/>
    </mxCell>

    <!-- Self-loop badge: log.sinfo not found -->
    <mxCell id="31"
      value="↺  log.sinfo not found — sleep 5s"
      style="rounded=1;html=1;fillColor=#f5f3ff;strokeColor=#c4b5fd;strokeWidth=1;fontSize=10;fontColor=#6d28d9;align=center;verticalAlign=middle;"
      vertex="1" parent="1">
      <mxGeometry x="462" y="256" width="246" height="24" as="geometry"/>
    </mxCell>

    <!-- Arrow 2: Detect → Start -->
    <mxCell id="81"
      value="log.sinfo found"
