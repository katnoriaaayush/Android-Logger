      edge="1" source="30" target="40" parent="1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- ═══════════════════════════════════════════════════
         STATE 3 — SESSION START
    ═══════════════════════════════════════════════════ -->
    <mxCell id="40"
      value="&lt;font style=&quot;font-size:13px;font-weight:bold;color:#15803d;&quot;&gt;3  |  Session Start&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#374151;&quot;&gt;· Creates /data/media/0/LogDaemon/logs/[timestamp]/&lt;br&gt;· Opens .log and .tsv writers per target package&lt;br&gt;· Spawns sync thread&lt;br&gt;· Forks logcat -T [last_ts] as root — replays ring buffer from checkpoint&lt;/font&gt;"
      style="rounded=1;html=1;fillColor=#f0fdf4;strokeColor=#86efac;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=16;spacingTop=12;spacingBottom=12;"
