      <mxGeometry x="80" y="95" width="640" height="100" as="geometry"/>
    </mxCell>

    <!-- Arrow 1: Boot → Detect -->
    <mxCell id="80"
      value="boot_completed = 1"
      style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#94a3b8;strokeWidth=2;fontSize=10;fontColor=#475569;fillColor=#f1f5f9;labelBackgroundColor=#f1f5f9;labelBorderColor=#e2e8f0;rounded=1;"
      edge="1" source="20" target="30" parent="1">
