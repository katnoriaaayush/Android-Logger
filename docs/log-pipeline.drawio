<mxfile host="app.diagrams.net" agent="Android-Logger" version="24.7.0">
  <diagram id="log-pipeline" name="Log capture pipeline">
    <mxGraphModel dx="1050" dy="720" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Cross-user logcat → filter → encrypt → internal storage" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="20" width="500" height="30" as="geometry" />
        </mxCell>

        <!-- ── main pipeline (left column) ── -->
        <mxCell id="logcat" value="logcat&#10;-b all -v uid,threadtime&#10;(provides ALL device logs)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="200" y="70" width="260" height="60" as="geometry" />
        </mxCell>

        <mxCell id="buffer" value="Time-delay buffer&#10;(holds UID-matched lines ~10s so late PIDs&#10;don't lose their early logs · FIFO)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="200" y="170" width="260" height="60" as="geometry" />
        </mxCell>

        <mxCell id="uidfilter" value="UID filter&#10;keep if  uid % 100000 == targetAppId&#10;(cross-user aware; drops other apps)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="200" y="270" width="260" height="60" as="geometry" />
        </mxCell>

        <mxCell id="pidfilter" value="PID filter&#10;keep if  pid ∈ pidSet(targetPackage)&#10;(removes shared-UID / system noise)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="200" y="370" width="260" height="60" as="geometry" />
        </mxCell>

        <mxCell id="encrypt" value="Encrypt (public key)&#10;AES-256-GCM per line&#10;+ session AES key RSA-OAEP-wrapped&#10;with the PUBLIC key (device can only lock)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="200" y="470" width="260" height="72" as="geometry" />
        </mxCell>

        <mxCell id="storage" value="Internal storage&#10;dataDir/logs/*.elog&#10;(user-0 private; exposed only via provider)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="200" y="582" width="260" height="60" as="geometry" />
        </mxCell>

        <!-- ── PID resolution (right column) ── -->
        <mxCell id="pidbox" value="PID resolution" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#b85450;verticalAlign=top;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="540" y="250" width="300" height="200" as="geometry" />
        </mxCell>

        <mxCell id="observer" value="IProcessObserver&#10;onProcessStarted / onProcessDied&#10;notifies on every process create / destroy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="286" width="260" height="60" as="geometry" />
        </mxCell>

        <mxCell id="pidmap" value="PID map&#10;packageName → { pid, pid, … }&#10;(kept current from observer callbacks)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="366" width="260" height="60" as="geometry" />
        </mxCell>

        <!-- public key input -->
        <mxCell id="pubkey" value="Public key&#10;(assets/public_key.pem)" style="shape=card;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="486" width="180" height="56" as="geometry" />
        </mxCell>

        <!-- ── pipeline edges ── -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="logcat" target="buffer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="buffer" target="uidfilter">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="pass" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="uidfilter" target="pidfilter">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="pass" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#333333;fontSize=11;" edge="1" parent="1" source="pidfilter" target="encrypt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1" source="encrypt" target="storage">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- drop annotations -->
        <mxCell id="dropuid" value="drop (other UID)" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="470" y="292" width="110" height="20" as="geometry" />
        </mxCell>
        <mxCell id="droppid" value="drop (PID not in set)" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="470" y="392" width="130" height="20" as="geometry" />
        </mxCell>

        <!-- ── PID resolution edges ── -->
        <mxCell id="e6" value="updates set" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#b85450;fontSize=11;" edge="1" parent="1" source="observer" target="pidmap">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="provides pidSet" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#d79b00;fontSize=11;" edge="1" parent="1" source="pidmap" target="pidfilter">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- public key → encrypt -->
        <mxCell id="e8" value="wraps AES key" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;strokeColor=#9673a6;fontSize=11;" edge="1" parent="1" source="pubkey" target="encrypt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
