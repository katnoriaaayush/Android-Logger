@startuml architecture

skinparam defaultFontSize 13
skinparam backgroundColor #ffffff
skinparam shadowing false
skinparam roundcorner 10
skinparam ArrowColor #64748b
skinparam state {
    BackgroundColor #f8fafc
    BorderColor     #94a3b8
}

title <size:16><b>logdaemon  --  Flow State Architecture</b></size>

[*] -[#3b82f6]-> Boot

state "  1  |  Boot  " as Boot #dbeafe {
    Boot : <b>init</b> reads  logdaemon.rc
    Boot : Runs as  uid = 0  (root)
    Boot : Waits for  sys.boot_completed = 1
}

state "  2  |  USB Detection  " as Detect #e9d5ff {
    Detect : Scans  /mnt/media_rw/  every 5 s
    Detect : Finds log.sinfo  ->  reads package list + options
    Detect : File closed immediately after read
    Detect : No USB handle retained
}

state "  3  |  Session Start  " as Start #bbf7d0 {
    Start : Creates  /data/media/0/LogDaemon/logs/[ts]/
    Start : Opens  .log  and  .tsv  writers per package
    Start : Spawns sync thread
    Start : Forks  logcat -T [last_ts]  as root
}

state "  4  |  Active Session  " as Active #f1f5f9 {

    state "  Main Thread  " as Main #d1fae5 {
        Main : Reads logcat pipe  (root)
        Main : Captures logs from all user profiles
        Main : Writes  .log / .tsv  to internal storage
        Main : Checkpoints  .last_ts  every 64 lines
    }

    state "  Sync Thread  " as Sync #fef9c3 {
        Sync : Wakes every 5 s
        Sync : Checks USB presence via  stat()
        Sync : Streams 64 KB chunks to USB
        Sync : open -> fwrite -> close  per cycle
        Sync : 3 consecutive misses  =  USB gone
    }

    Main -[hidden]right-> Sync

}

state "  5  |  Session End  " as End #fed7aa {
    End : g_usb_gone = 1  ->  capture loop exits
    End : Writers flushed and closed
    End : _summary.tsv  written to internal storage
    End : Sync thread performs final USB flush
    End : init restarts daemon after 5 s
}

Boot   -[#3b82f6]->  Detect  : boot_completed = 1
Detect -[#94a3b8]->  Detect  : log.sinfo not found
Detect -[#16a34a]->  Start   : log.sinfo found
Start  -[#7c3aed]->  Active  : threads running
Sync               -->  End  : USB ejected  (3 misses)
End    -[#94a3b8]-up->  Detect  : restarted by init

@enduml
