<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Socket access to logd -->
    <uses-permission android:name="android.permission.READ_LOGS" />

    <!-- Required to start a ForegroundService and keep it alive -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+: must declare the specific foreground service type -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Auto-start on device boot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Write captured log file to owner-profile external storage (/sdcard/) -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- KpiEventService: read Settings values via ContentObserver -->
    <uses-permission android:name="android.permission.READ_SETTINGS" />
    <!-- ConnectivityManager.registerNetworkCallback requires ACCESS_NETWORK_STATE -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- WiFi scan results -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- App usage stats (same data source as Digital Wellbeing); auto-granted for UID 1000 -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />

    <!-- USB-sync pathway: open a user-0 ContentProvider FD from the foreground user -->
    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS_FULL" />
    <!-- Write completed log segments to the mounted removable (USB) volume -->
    <uses-permission android:name="android.permission.WRITE_MEDIA_STORAGE" />

    <!--
        Signature permission guarding LogProvider — only this app's own
        UsbSyncService (in any user) can reach the user-0 log files.
    -->
    <permission
        android:name="com.sqa.logtest.permission.LOGS"
        android:protectionLevel="signature" />

    <application
        android:allowBackup="false"
        android:label="CrossUserLogTest"
        android:persistent="true"
        android:theme="@style/Theme.AppCompat.Light.DarkActionBar">

        <!--
            MainActivity — status and control UI.
            Not singleUser: shows on whatever profile opens the launcher icon.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            LogCaptureService — the actual log capture worker.

            singleUser="true"     — runs in user 0 (owner) only; not instantiated
                                    in secondary profiles even if they start it.
            persistent="true"     — process is kept alive by the system and
                                    restarted if killed (effective only for system apps).
            directBootAware="true"— can start before the user unlocks the device,
                                    so no boot logs are missed.
            foregroundServiceType — required on Android 14+ for ForegroundService.
        -->
        <service
            android:name=".LogCaptureService"
            android:singleUser="true"
            android:persistent="true"
            android:directBootAware="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
            KpiEventService — listens for event-based KPIs via framework callbacks.
            Registers BroadcastReceivers, ContentObservers, and NetworkCallback at runtime.
        -->
        <service
            android:name=".KpiEventService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- ════════════ Cross-user log → USB sync pathway ════════════ -->

        <!--
            LoggerService — user-0 PRODUCER. UID+PID hybrid logcat capture →
            rotated completed segments in dataDir/logs/. singleUser + gated on
            user 0 so a secondary profile never spawns a second producer.
        -->
        <service
            android:name=".LoggerService"
            android:singleUser="true"
            android:persistent="true"
            android:directBootAware="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
            LogProvider — singleUser window onto completed log-*.log segments.
            Exposes ParcelFileDescriptors (never paths) across the user boundary;
            guarded by the signature permission above.
        -->
        <provider
            android:name=".LogProvider"
            android:authorities="com.sqa.logtest.logs"
            android:singleUser="true"
            android:exported="true"
            android:permission="com.sqa.logtest.permission.LOGS" />

        <!--
            UsbSyncService — runs in the FOREGROUND user (the only one with the
            USB mounted). Reads user-0 logs via content://0@… and streams them
            to the stick; progress state lives in a manifest ON the stick.
        -->
        <service
            android:name=".UsbSyncService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
            UsbMountReceiver — fires in the foreground user on media mount and
            kicks off UsbSyncService.
        -->
        <receiver
            android:name=".UsbMountReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_MOUNTED" />
                <data android:scheme="file" />
            </intent-filter>
        </receiver>

        <!--
            BootReceiver — starts LogCaptureService on boot.

            directBootAware="true" allows it to fire on LOCKED_BOOT_COMPLETED
            (before unlock) as well as BOOT_COMPLETED (after unlock).
            Priority 999 ensures it runs early relative to other receivers.
        -->
        <receiver
            android:name=".BootReceiver"
            android:directBootAware="true"
            android:exported="false">
            <intent-filter android:priority="999">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
