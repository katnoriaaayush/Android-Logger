<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- UID / status info -->
    <TextView
        android:id="@+id/tv_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:textSize="12sp"
        android:padding="12dp"
        android:background="#1e1e2e"
        android:textColor="#cdd6f4" />

    <!-- Log capture — start row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/btn_start_pid"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Start PID"
            android:backgroundTint="#2e7d32" />

        <Button
            android:id="@+id/btn_start_uid"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Start UID"
            android:backgroundTint="#e65100" />

        <Button
            android:id="@+id/btn_start_hybrid"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Start UID+PID"
            android:backgroundTint="#1565c0" />
    </LinearLayout>

    <!-- Log capture — control row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <Button
            android:id="@+id/btn_stop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Stop Capture"
            android:backgroundTint="#b71c1c" />

        <Button
            android:id="@+id/btn_refresh"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Refresh" />
    </LinearLayout>

    <!-- KPI logging buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btn_kpi_start"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Start KPI Logging"
            android:backgroundTint="#4a9eff" />

        <Button
            android:id="@+id/btn_kpi_stop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Stop KPI Logging"
            android:backgroundTint="#ff6b6b" />
    </LinearLayout>

    <!-- App usage stats -->
    <Button
        android:id="@+id/btn_fetch_usage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Fetch App Usage Stats (frequency + runtime)"
        android:backgroundTint="#6a4eff" />

    <!-- Live status badge -->
    <TextView
        android:id="@+id/tv_live_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="monospace"
        android:textSize="11sp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:text="◌  KPI service not running"
        android:textColor="#9E9E9E" />

    <!-- Live log viewer -->
    <ScrollView
        android:id="@+id/scroll_log"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/tv_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:padding="8dp"
            android:background="#1a1a2e"
            android:textColor="#e0e0ff"
            android:text="No data yet." />
    </ScrollView>

</LinearLayout>
